{
  "extends": "./tsconfig.json",
  "include": ["src", "test"],
  "exclude": ["test/types"],
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "module": "ES2022",
    "target": "ES2022",
    "rootDir": ".",
    "paths": { "@supabase/postgrest-js": ["./src/index.ts"] }
  },
  "contentMappers": [
    {
      "package": "@supabase/postgrest-mapper",
      "extensions": [".pgrst-index"],
      "options": {
        "postgrest": "16.4",
        "schema": { "source": "snapshot", "path": "test/postgrest-schema.json" },
        "defaultSchema": "public",
        "scan": ["test/**/*.test.ts"]
      }
    }
  ]
}
