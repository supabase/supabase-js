+-- | 'registerDelay' needs the threaded RTS, which the wasm32-wasi backend does not have.
+registerDelayUnthreaded :: Int -> IO (TVar Bool)
+registerDelayUnthreaded n = do
+  var <- newTVarIO False
+  _ <- forkIO (threadDelay n >> atomically (writeTVar var True))
+  return var
