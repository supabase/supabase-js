+#elif defined(wasi_HOST_OS)
+-- The wasm RTS has no event manager (it requires the threaded RTS), so each
+-- timeout is a green thread sleeping until a deadline that 'updateTimeout' can move.
+data TimerManager = TimerManager
+
+data TimeoutKey = TimeoutKey ThreadId (IORef Word64)
+
+getTimerManager :: IO TimerManager
+getTimerManager = pure TimerManager
+
+registerTimeout :: TimerManager -> Int -> IO () -> IO TimeoutKey
+registerTimeout _ us action = do
+    now <- getMonotonicTimeNSec
+    deadline <- newIORef (now + fromIntegral us * 1000)
+    let loop = do
+            dl <- readIORef deadline
+            t <- getMonotonicTimeNSec
+            if t >= dl
+                then action
+                else threadDelay (fromIntegral ((dl - t) `div` 1000) + 1) >> loop
+    tid <- forkIO loop
+    pure (TimeoutKey tid deadline)
+
+unregisterTimeout :: TimerManager -> TimeoutKey -> IO ()
+unregisterTimeout _ (TimeoutKey tid _) = killThread tid
+
+updateTimeout :: TimerManager -> TimeoutKey -> Int -> IO ()
+updateTimeout _ (TimeoutKey _ deadline) us = do
+    now <- getMonotonicTimeNSec
+    when (us >= 0) $ atomicWriteIORef deadline (now + fromIntegral us * 1000)
 #else
+type TimeoutKey = EV.TimeoutKey
+
 getTimerManager :: IO EV.TimerManager
 getTimerManager = EV.getSystemTimerManager
 #endif
