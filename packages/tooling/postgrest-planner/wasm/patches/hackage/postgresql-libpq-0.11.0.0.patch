+-- The runtime has a single OS thread, so a blocking PQconnectdb would stall
+-- every other Haskell thread for the whole handshake. The socket is waited on
+-- in Haskell instead, and the connection is left nonblocking so that later
+-- sends cannot block in C either.
+pollUntilDone :: (Connection -> IO PollingStatus) -> Connection -> IO Bool
+pollUntilDone poll connection = wait PollingWriting
+  where
+    wait st = case st of
+        PollingOk      -> return True
+        PollingFailed  -> return False
+        PollingReading -> socket connection >>= maybe (return False) (\fd -> waitConnect (threadWaitRead fd) >> step)
+        PollingWriting -> socket connection >>= maybe (return False) (\fd -> waitConnect (threadWaitWrite fd) >> step)
