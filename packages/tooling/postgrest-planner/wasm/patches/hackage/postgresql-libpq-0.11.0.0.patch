+-- Waits for the server in Haskell, so that PQgetResult never blocks the
+-- whole (single-threaded) runtime while a query is running.
+waitResultReady :: Connection -> IO ()
+waitResultReady connection = flushAll connection >>= \flushed ->
+    if flushed then consumeInput connection >>= \ok -> if ok then loop else return () else return ()
+  where
+    loop = do
+        busy <- isBusy connection
+        if not busy
+            then return ()
+            else do
+                mfd <- socket connection
+                case mfd of
+                    Nothing -> return ()
+                    Just fd -> do
+                        threadWaitRead fd
+                        ok <- consumeInput connection
+                        if ok then loop else return ()
+
+
+-- Runs a PQsend* call and, on a nonblocking connection, waits in Haskell until
+-- the queued output has left, so the call still reports a send failure.
+sendFlushed :: Connection -> (Ptr PGconn -> IO CInt) -> IO Bool
+sendFlushed connection send = do
+    sent <- enumFromConn connection send
+    if sent then flushAll connection else return False
+
+-- Flushes queued output. While the kernel buffer is full the socket is waited
+-- on for read or write readiness and incoming data is consumed, as PQflush
+-- documents: a server blocked sending notices or results does not read the
+-- rest of the output until the client reads. 'False' means the flush or the
+-- read failed.
+flushAll :: Connection -> IO Bool
+flushAll connection = flush connection >>= \st -> case st of
+    FlushOk      -> return True
+    FlushFailed  -> return False
+    FlushWriting -> socket connection >>= maybe (return False) (\fd -> do
+        waitReadOrWrite fd
+        ok <- consumeInput connection
+        if ok then flushAll connection else return False)
+
+-- Each readiness is awaited by its own thread. Cleanup is uninterruptible
+-- because killThread is interruptible even under mask, and a cancellation
+-- between the two kills would orphan a waiter on the socket.
+waitReadOrWrite :: Fd -> IO ()
+waitReadOrWrite fd = mask $ \restore -> do
+    ready <- newEmptyMVar
+    r <- forkIO (threadWaitRead fd >> () <$ tryPutMVar ready ())
+    w <- forkIO (threadWaitWrite fd >> () <$ tryPutMVar ready ())
+    restore (takeMVar ready) `finally` uninterruptibleMask_ (killThread r >> killThread w)
 
