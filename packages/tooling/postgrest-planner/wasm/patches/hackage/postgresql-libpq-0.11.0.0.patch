+    done <- newEmptyMVar
+    r <- forkIO (ready >> () <$ tryPutMVar done True)
+    t <- forkIO (threadDelay (fromIntegral (min ms 1000000) * 1000) >> () <$ tryPutMVar done False)
+    restore (takeMVar done) `finally` uninterruptibleMask_ (killThread r >> killThread t)
