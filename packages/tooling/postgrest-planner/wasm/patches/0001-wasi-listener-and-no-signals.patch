 -- | Set signal handlers, only for systems with signals
 installSignalHandlers :: Observation.ObservationHandler -> IO () -> IO () -> IO () -> IO ()
-#ifndef mingw32_HOST_OS
+#if defined(wasi_HOST_OS)
+-- | The host delivers signals as one byte each on SUPA_SIGNAL_FD (HUP=1, INT=2, USR1=10, USR2=12,
+-- TERM=15) and closes it at exit, which is handled as TERM.
+installSignalHandlers observer interrupt usr1 usr2 =
+  lookupEnv "SUPA_SIGNAL_FD" >>= maybe pass (void . forkIO . watch . Fd) . (>>= readMaybe)
+  where
+    watch fd = do
+      threadWaitRead fd
+      readByte fd >>= \case
+        Retry -> watch fd
+        Closed -> terminate "SIGTERM"
+        Byte 2 -> terminate "SIGINT"
+        Byte 15 -> terminate "SIGTERM"
+        Byte 10 -> reload usr1 >> watch fd
+        Byte 12 -> reload usr2 >> watch fd
+        Byte _ -> watch fd
+    -- Reloads run on their own thread so a stalled database query cannot delay a later TERM.
+    reload = void . forkIO
+    terminate name = observer (Observation.TerminationUnixSignalObs name) >> interrupt
+
+data SignalRead = Byte Word8 | Retry | Closed
+
+readByte :: Fd -> IO SignalRead
+readByte (Fd fd) = alloca $ \buf -> do
+  n <- c_read fd buf 1
+  case compare n 0 of
+    GT -> Byte <$> peek buf
+    EQ -> pure Closed
+    LT -> do
+      err <- getErrno
+      pure $ if err == eAGAIN || err == eINTR then Retry else Closed
+
+foreign import ccall unsafe "read"
+  c_read :: CInt -> Ptr Word8 -> CSize -> IO CSsize
+#elif !defined(mingw32_HOST_OS)
 installSignalHandlers observer interrupt usr1 usr2 = do
   install Signals.sigINT  $ observer (Observation.TerminationUnixSignalObs "SIGINT") >> interrupt
   install Signals.sigTERM $ observer (Observation.TerminationUnixSignalObs "SIGTERM") >> interrupt
