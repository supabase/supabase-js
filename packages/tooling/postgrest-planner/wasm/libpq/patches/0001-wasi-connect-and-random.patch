+#ifdef __wasi__
+/*
+ * Milliseconds left of the handshake budget for the current address, or -1
+ * when connect_timeout does not apply.
+ */
+int
+pg_wasi_connect_remaining_ms(PGconn *conn)
+{
+	pg_usec_time_t now;
+
+	if (conn == NULL || conn->wasi_deadline_us < 0)
+		return -1;
+	now = PQgetCurrentTimeUSec();
+	if (conn->wasi_deadline_us <= now)
+		return 0;
+	return (int) Min((conn->wasi_deadline_us - now + 999) / 1000, INT_MAX);
+}
+
+/*
+ * What pqConnectDBComplete() does when connect_timeout elapses; the caller
+ * then keeps polling so libpq moves on to the next address or host.
+ */
+void
+pg_wasi_connect_expire(PGconn *conn)
+{
+	libpq_append_conn_error(conn, "timeout expired");
+	conn->try_next_addr = true;
+	conn->status = CONNECTION_NEEDED;
+}
