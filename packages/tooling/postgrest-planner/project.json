{
  "name": "postgrest-planner",
  "targets": {
    "build:wasm": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./build.sh",
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{projectRoot}/haskell/**/*",
        "{projectRoot}/patches/**/*",
        "{projectRoot}/build.sh"
      ],
      "outputs": ["{projectRoot}/dist/postgrest-planner.wasm"],
      "cache": false
    }
  }
}
